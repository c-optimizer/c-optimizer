{
  "name": "c-optimizer",
  "version": "1.0.0",
  "description": "C-Optimizer - Otimização e Manutenção de Sistema Windows",
  "main": "src/main/main.js",
  "author": "Caio",
  "license": "MIT",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env-shell NODE_ENV=development \"wait-on tcp:5173 && electron .\"",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:electron": "cross-env-shell CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "build": "npm run build:renderer && npm run build:electron"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "8.2.0",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^0.446.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.5"
  },
  "build": {
    "appId": "com.coptimizer.app",
    "productName": "C-Optimizer",
    "copyright": "Copyright © 2026 C-Optimizer",
    "asar": true,
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "c-optimizer",
      "repo": "c-optimizer",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "C-Optimizer",
      "artifactName": "C-Optimizer-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ]
  },
  "linux": {
    "target": "AppImage",
    "icon": "build/icon.ico"
  }
}
